{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.js",
"scripts": {
  "dev": "next dev",
  "dev-next": "next dev",
  "dev-electron": "wait-on http://localhost:3000 && cross-env NODE_ENV=production electron .",
  "dev-all": "concurrently \"npm run dev-next\" \"npm run dev-electron\"",
  "next:build": "next build && node -e \"const fs = require('fs'); fs.cpSync('public', '.next/standalone/public', { recursive: true }); fs.cpSync('.next/static', '.next/standalone/.next/static', { recursive: true });\"",
  "electron:build": "electron-builder",
  "build": "npm run next:build && npm run electron:build",
  "start": "next start",
  "lint": "eslint",
  "clean" : "rimraf dist .next out"
},

  "dependencies": {
    "@anthropic-ai/sdk": "^0.106.0",
    "@auth/core": "^0.34.3",
    "@base-ui/react": "^1.9.0",
    "@tiptap/extension-blockquote": "^3.27.1",
    "@tiptap/extension-bubble-menu": "^3.27.1",
    "@tiptap/extension-bullet-list": "^3.27.1",
    "@tiptap/extension-code-block": "^3.27.1",
    "@tiptap/extension-color": "^3.27.1",
    "@tiptap/extension-font-family": "^3.27.1",
    "@tiptap/extension-hard-break": "^3.27.1",
    "@tiptap/extension-heading": "^3.27.1",
    "@tiptap/extension-highlight": "^3.27.1",
    "@tiptap/extension-horizontal-rule": "^3.27.1",
    "@tiptap/extension-image": "^3.27.1",
    "@tiptap/extension-link": "^3.27.1",
    "@tiptap/extension-list-item": "^3.27.1",
    "@tiptap/extension-ordered-list": "^3.27.1",
    "@tiptap/extension-placeholder": "^3.27.1",
    "@tiptap/extension-strike": "^3.27.1",
    "@tiptap/extension-subscript": "^3.27.1",
    "@tiptap/extension-superscript": "^3.27.1",
    "@tiptap/extension-table": "^3.27.1",
    "@tiptap/extension-table-cell": "^3.27.1",
    "@tiptap/extension-table-header": "^3.27.1",
    "@tiptap/extension-table-row": "^3.27.1",
    "@tiptap/extension-task-item": "^3.27.1",
    "@tiptap/extension-task-list": "^3.27.1",
    "@tiptap/extension-text-align": "^3.27.1",
    "@tiptap/extension-text-style": "^3.27.1",
    "@tiptap/extension-typography": "^3.27.1",
    "@tiptap/extension-underline": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.21.0",
    "mongoose": "^9.7.2",
    "next": "^16.2.9",
    "next-auth": "^4.24.14",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-pdf": "^10.4.1",
    "recharts": "^3.9.0",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "uploadthing": "^6.12.0",
    "wait-on": "^9.5.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
"build": {
  "appId": "com.Shleve.client",
  "productName": "Shleve",
  "asar": false,
  "directories": {
    "output": "dist"
  },
  "files": [
    "electron/**/*",
    ".next/standalone/**/*",
    "public/icon.png",
    ".env",
    "package.json"
  ],
  "win": {
    "target": "nsis",
    "icon": "public/icon.png"
  },
  "mac": {
    "target": "dmg",
    "icon": "public/icon.png"
  },
  "linux": {
    "target": "AppImage",
    "icon": "public/icon.png",
    "category": "Utility"
  }
}



}
